# Caddy reverse proxy — automatic HTTPS via Let's Encrypt.
# Replace parser.example.com with your real (sub)domain, then point that
# domain's DNS A record at this VPS's public IP before starting the stack.

parser.example.com {
	encode gzip

	# Bank statements can be large (long text PDFs, or scanned PDFs needing OCR) —
	# allow big uploads and give the backend time to finish. Keep max_size in sync
	# with MAX_UPLOAD_MB in the app, and the timeouts >= gunicorn's --timeout.
	request_body {
		max_size 200MB
	}
	reverse_proxy app:8080 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
