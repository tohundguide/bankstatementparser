# ─── Sensitive Data ───
Ref Docs/

# ─── Build & Deploy ───
# docker-compose.yml is intentionally tracked (see deployment exceptions at the
# bottom of this file). No secrets live in it — secrets stay in .env.

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# ─── Virtual Environments ───
venv/
env/
.venv/
.env

# ─── Uploaded & Generated Files ───
uploads/*
!uploads/.gitkeep
output/*
!output/.gitkeep
feedback/*
!feedback/.gitkeep
learned/cache/*
!learned/cache/.gitkeep

# ─── Test & Debug Files ───
test_*.py
check_*.py
deep_analyze.py
extract_docx.py
analyze_statements.py
*.log
*.txt
!requirements.txt
*.md
!README.md
!GROWTH_STRATEGY.md

# ─── IDE & OS ───
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store

# ─── Gemini ───
.gemini/
.agent/
*.pdf

# ─── Deployment & HDFC regression test (force-tracked) ───
# These must override the broad *.md / *.txt / test_*.py rules above so the
# VPS deploy files and the HDFC OCR regression suite reach the repo/server.
!docker-compose.yml
!DEPLOY_VPS.md
!tests/test_hdfc_robustness.py
!tests/hdfc_seiza_fixture.txt
!tests/seiza_ocr_dump.txt
!tests/cafe_seiza_ocr_dump.txt
