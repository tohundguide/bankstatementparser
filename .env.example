# Bank Statement Parser — Environment Variables
# =============================================

# Google Gemini API Key (optional)
# Enables the AI fallback parser that can handle ANY bank format.
# Get a free key at: https://aistudio.google.com/apikey
# Without this key, only structured parsers (JK Bank, Equitas, etc.) will work.
GEMINI_API_KEY=

# Daily LLM call limit (optional, default: 20)
# Controls max AI parsing calls per day to cap costs.
# At ~₹0.15/call, 20 calls/day = max ₹3/day = ₹90/month
# The system caches results, so effective cost is much lower.
LLM_DAILY_LIMIT=20

# ── Public API Configuration ──

# API Keys (comma-separated, format: key:label)
# Each key grants access to /api/v1/parse for programmatic bank statement parsing.
# Example: abc123def456:MyFinApp,xyz789ghi012:ClientCA
API_KEYS=

# Rate limit per API key (requests per hour, default: 30)
# Controls how many /api/v1/parse requests a single key can make per hour.
API_RATE_LIMIT=30
